# Copy to .env and fill in. .env is gitignored; this file is not.

# api.data.gov key, used for GovInfo (Congressional Record, Statutes at Large).
# Free and instant from https://api.data.gov/signup/
GOVINFO_API_KEY=

# Google AI Studio key for Gemini, used by the offline content pipeline only —
# never on the vote path. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# One gateway for embeddings, generation and the neutrality judge.
# https://openrouter.ai/keys — set a credit limit on the key.
OPENROUTER_API_KEY=

# OpenRouter slug. Must be able to emit EMBEDDING_DIM (768) dimensions, which
# rules out bge-m3 and Mistral Embed (fixed 1024) and voyage-4 (256/512/1024/
# 2048 only). Changing it does not invalidate stored vectors: `model` is part
# of chunk_embeddings' primary key, so two models coexist and retrieval.nearest
# makes the caller name one.
EMBEDDING_MODEL=google/gemini-embedding-001
