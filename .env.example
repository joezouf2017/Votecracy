# Copy to .env and fill in. .env is gitignored; this file is not.

# api.data.gov key, used for GovInfo (Congressional Record, Statutes at Large).
# Free and instant from https://api.data.gov/signup/
GOVINFO_API_KEY=

# Google AI Studio key for Gemini, used by the offline content pipeline only —
# never on the vote path. https://aistudio.google.com/apikey
GEMINI_API_KEY=
